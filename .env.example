# Copiá este archivo como .env y completá tus datos de MySQL. El .env no se sube a git.
# Dejá las comillas simples: permiten usar símbolos como $ o # en la contraseña.
ConnectionStrings__Default='server=localhost;port=3306;database=sistemcheck;user=root;password=TU_CONTRASEÑA'

# Opcional: orígenes web de otros grupos que pueden llamar a la API desde el navegador (CORS).
# Uno por variable, numerados desde 0. Sin ninguno, no se permite ningún origen.
# Cors__OrigenesPermitidos__0='http://localhost:3000'
# Cors__OrigenesPermitidos__1='http://192.168.0.20:8080'
